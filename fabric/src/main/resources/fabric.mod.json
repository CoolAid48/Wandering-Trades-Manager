{
  "schemaVersion": 1,
  "id": "wanderingtradesmanager",
  "version": "${version}",
  "name": "Wandering Trades Manager",
  "description": "Adds a robust config screen for easier management of your Wandering Trades datapack from Vanilla Tweaks",
  "authors": [
    "CoolAid48"
  ],
  "contributors": [
    "Vanilla Tweaks Team",
    "JeremiahScottie"
  ],
  "contact": {
    "homepage": "https://coolaid.live/",
    "issues": "https://github.com/CoolAid48/Wandering-Trades-Manager/issues",
    "sources": "https://github.com/CoolAid48/Wandering-Trades-Manager"
  },
  "license": "MIT",
  "icon": "assets/wandering-trades-manager/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.coolaid.wanderingTradesManager.fabric.WanderingTradesManagerFabric"
    ],
    "client": [
      "me.coolaid.wanderingTradesManager.fabric.client.WanderingTradesManagerFabricClient"
    ],
    "modmenu": [
      "me.coolaid.wanderingTradesManager.fabric.client.WanderingTradesManagerModMenu"
    ]
  },
  "mixins": [
    "wandering-trades-manager.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~26.1",
    "fabric-api": "*"
  }
